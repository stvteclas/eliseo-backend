ENV=development
DATABASE_URL=sqlite:///./eliseo.db

JWT_SECRET=

ANTHROPIC_API_KEY=
MCP_SANDBOX_URL=http://127.0.0.1:8001/mcp
DEEPGRAM_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/connectors/google_calendar/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Directions API (tráfico en vivo). Habilitar Directions API en Cloud Console.
GOOGLE_MAPS_API_KEY=
# Spotify (opcional): app en https://developer.spotify.com → Client ID + Secret.
# Sin esto, "poné música" reproduce en YouTube Music (video concreto).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# YouTube Data API v3 (opcional). Si vacío, se usa búsqueda pública Invidious.
YOUTUBE_API_KEY=
# Para mails: en Cloud Console habilitar también "Gmail API" y reconectar Calendar
# (el OAuth ahora pide gmail.readonly / gmail.send).
# Para Chat: habilitar "Google Chat API" y "People API" (contactos),
# y reconectar (scopes chat.spaces / chat.messages / chat.memberships.readonly + contacts.readonly).
# Avisos proactivos: la app hace poll a /connectors/google_calendar/chat/updates
# mientras está en vivo (alerta + lee el mensaje en voz).

ENCRYPTION_KEY=

# Solo para depurar callbacks OAuth (muestra el error del proveedor en pantalla)
OAUTH_DEBUG=false

WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Telegram cuenta personal (my.telegram.org → API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

MP_ACCESS_TOKEN=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=http://localhost:8000/connectors/mercadopago/callback

MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:8000/connectors/teams_calendar/callback
MS_TENANT=common
